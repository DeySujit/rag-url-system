# ============================ General ============================
APP_NAME=rag-url-ingestion
LOG_LEVEL=INFO
ENVIRONMENT=development

# ======================= OpenAI / Embeddings =====================
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=2048
EMBEDDING_BATCH_SIZE=128
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_MAX_RETRIES=6

# ============================ Crawler ============================
CRAWL_MAX_DEPTH=1
CRAWL_MAX_PAGES=50
CRAWL_SAME_DOMAIN_ONLY=true
CRAWL_CONCURRENCY=5
CRAWL_TIMEOUT_SECONDS=30

# =========================== Chunking ===========================
CHUNK_TARGET_TOKENS=1000
CHUNK_MIN_TOKENS=800
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP_TOKENS=175

# ========================= Vector store =========================
# one of: pgvector | pinecone | qdrant | weaviate | milvus
VECTOR_BACKEND=pgvector
VECTOR_NAMESPACE=default
VECTOR_COLLECTION=rag_chunks
UPSERT_BATCH_SIZE=100

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=rag-chunks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# ===================== Postgres (pgvector) ======================
DB_NAME_LOCAL=rag
DB_USERNAME_LOCAL=postgres
DB_PASSWORD_LOCAL=postgres
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=5432

# ========================= Redis / Celery =======================
REDIS_URL=redis://localhost:6379/0
